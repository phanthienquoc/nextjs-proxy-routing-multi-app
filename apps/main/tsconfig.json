{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "incremental": true,
    "moduleResolution": "Bundler",
    "baseUrl": "./",
    "paths": {
      "@/*": ["./src/*"]
    },
    "plugins": [{ "name": "next" }]
  },
  "include": ["next-env.d.ts", "src/**/*", "next.config.mjs", "next.config.js", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
